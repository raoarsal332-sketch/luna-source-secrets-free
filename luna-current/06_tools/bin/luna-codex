#!/usr/bin/env bash
set -euo pipefail
# Default staging; set LUNA_CODEX_ROOT=/home/ubuntu for prod tree (Arsal CoS-aligned access).
ROOT="${LUNA_CODEX_ROOT:-/home/ubuntu/luna-codex-staging}"
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
nvm use 22 >/dev/null 2>&1 || true

# Intercom MCP (Codex) — load token for bearer auth; never echo it
if [ -f /home/ubuntu/.env ]; then
  set -a
  # shellcheck disable=SC1091
  . /home/ubuntu/.env
  set +a
fi
if [ -f "$HOME/.config/luna-codex/openai.env" ]; then
  set -a; . "$HOME/.config/luna-codex/openai.env"; set +a
fi
cd "$ROOT"
export CODEX_SANDBOX="${CODEX_SANDBOX:-danger-full-access}"
exec codex -c 'sandbox_mode="danger-full-access"' -c 'approval_policy="never"' "$@"
