+// Final payout stage for every public body. This helper does not send by itself.
+// It runs only after ownership (Fin wait), already-replied, human-teammate, pause,
+// and aiOff checks. Those skips still return before this helper is called, so a
+// suppressed send stays suppressed. The helper runs after presend rewriting,
+// identity replacement, variant clarification, welcome text, and repeat retries.
+// A postgate hit does not return null: a failed postgate is a deny, so the helper
+// hedges and never passes that body through. A defer window suppresses every public
+// send, including the forward line, status lines, and retries, in every script.
+// An empty or erase turn outside that window posts the localized hedge. Empty model
+// replies are sent through postClientCommentOnce so they reach this stage.
+// Customer turns, identity retries, and deferred replies that later send go
+// through postClientCommentOnce. Owner REPLY, send-this-message, and FOLLOW
+// (which executes an owner REPLY) are guarded at their post. Owner-dictated
+// text is guarded. Fail closed to the visible hedge. The directory that would
+// hold presend state under 01_runtime is absent and this helper does not require it.
+function payoutLatestClient(parts) {
+  const list = Array.isArray(parts) ? parts : [];
+  for (let i = list.length - 1; i >= 0; i--) {
+    const part = list[i];
+    if (!part) continue;
+    const author = part.author || {};
+    const type = String(author.type || part.role || '');
+    if (type !== 'user' && type !== 'lead' && type !== 'client') continue;
+    const raw = part.body || part.text || '';
+    return typeof stripHtml === 'function' ? stripHtml(raw) : String(raw);
+  }
+  return '';
+}
