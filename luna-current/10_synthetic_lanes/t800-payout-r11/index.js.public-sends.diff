+// T800 payout R11. Runs for every public comment that goes through
+// postClientCommentOnce, including identity recovery, the Fin welcome,
+// and review-status, and also for the owner REPLY and the authorized-note
+// REPLY. The postgate suppression branch and the missed-escalation greet
+// and personal-question arms are guarded too. Early returns inside
+// postClientCommentOnceInner run the guard before they drop a body.
+// This is not a presend-only hook.
+// The directory that would hold presend state under 01_runtime is absent; this helper does not require it.
+// Fail closed: a throw, a silent result, or an empty body becomes the
+// visible hedge. The original draft is not posted, and the send is not dropped.
+function payoutGuardPublicBody(body, parts) {
+  const hedge = "I can't confirm that. Our team will confirm.";
+  try {
+    const payoutGuard = require('../10_synthetic_lanes/t800-payout-r11/payoutClaimGuard');
+    const payoutParts = (Array.isArray(parts) ? parts : []).map((p) => Object.assign({}, p, {
+      body: typeof stripHtml === 'function' ? stripHtml((p && (p.body || p.text)) || '') : ((p && (p.body || p.text)) || ''),
+    }));
+    const payout = payoutGuard.guardPublicBody(body, {
+      messages: payoutGuard.partsToMessages(payoutParts, [
+        typeof ARSAL_ID !== 'undefined' ? ARSAL_ID : '',
+        typeof ELITE_AI_ID !== 'undefined' ? ELITE_AI_ID : '',
+      ]),
+    });
+    if (!payout || payout.silent || payout.send !== true || !payout.body) {
+      console.error('PAYOUT_GUARD_FAIL_CLOSED', payout && payout.reason);
+      return hedge;
+    }
+    if (payout.failClosed || payout.replaced) console.log('PAYOUT_GUARD_VISIBLE_HEDGE', payout.reason);
+    return payout.body;
+  } catch (err) {
+    console.error('[payoutClaimGuard] fail-closed', err && err.message);
+    return hedge;
+  }
+}
+
+function payoutGuardInsteadOfDrop(conversationId, body, parts) {
+  const out = payoutGuardPublicBody(body, parts);
+  if (out !== String(body == null ? '' : body)) return postReply(conversationId, 'comment', out);
+  return null;
+}
